{
  "name": "digital-edu-web",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "copy:monaco": "rm -rf public/monaco && mkdir -p public/monaco && cp -r node_modules/monaco-editor/min/vs public/monaco/vs",
    "predev": "npm run copy:monaco",
    "prebuild": "npm run copy:monaco",
    "build": "vite build && rm -rf ../static/spa && cp -r dist ../static/spa",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
